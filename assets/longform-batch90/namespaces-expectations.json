        "{urn:example:two}item"
      ]
    },
    "C": {
      "xml": "<root xmlns=\"urn:example:one\" id=\"K1\"/>",
      "expectedTag": "{urn:example:one}root",
      "expectedAttributes": {
        "id": "K1"
      }
    },
    "D": {
      "xml": "<root xmlns:a=\"urn:example:one\" id=\"K1\" a:id=\"K2\"/>",
      "expectedAttributes": {
        "id": "K1",
        "{urn:example:one}id": "K2"
      }
    },
    "E": {
      "xml": [
        "<root xmlns=\"urn:example:one\"><item xmlns=\"\"/></root>",
        "<root xmlns=\"urn:example:one\"><item/></root>"
      ],
      "expectedChildTags": [
        "item",
        "{urn:example:one}item"
      ]
    },
    "F": {
      "xml": "<root xmlns:one=\"urn:example:one\" xmlns:two=\"urn:example:two\"><one:item code=\"A\"/><two:item code=\"B\"/></root>",
