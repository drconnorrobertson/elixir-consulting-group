        "<a:item xmlns:a=\"urn:example:one\"/>",
        "<b:item xmlns:b=\"urn:example:one\"/>"
      ],
      "expectedTag": "{urn:example:one}item"
    },
    "B": {
      "xml": [
        "<a:item xmlns:a=\"urn:example:one\"/>",
        "<a:item xmlns:a=\"urn:example:two\"/>"
      ],
      "expectedTags": [
